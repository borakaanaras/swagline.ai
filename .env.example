# Sadece HERKESE AÇIK değerler. Gizli API anahtarı buraya veya herhangi bir EXPO_PUBLIC_* değişkenine KONMAZ.
# Try-on servisi: mock (varsayılan) | dev-server (geçici yerel sunucu, bkz. dev-server/)
EXPO_PUBLIC_TRYON_BACKEND=mock
# dev-server için: Mac'in yerel ağ adresi (ipconfig getifaddr en0) ve dev-server/.env'deki DEV_SERVER_KEY
EXPO_PUBLIC_DEV_SERVER_URL=http://192.168.1.10:8787
EXPO_PUBLIC_DEV_SERVER_KEY=
# Geliştirmede false: deneme limiti/ödeme ekranı kapalı.
EXPO_PUBLIC_PAYWALL_ENABLED=false

{
  "expo": {
    "name": "SwaglineAI",
    "slug": "SwaglineAI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.swagline.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0F12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ai.swagline.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "SwaglineAI, kıyafetleri üzerinde deneyebilmen için galerinden fotoğraf seçmene izin ister.",
          "cameraPermission": "SwaglineAI, tam boy fotoğrafını çekebilmen için kameraya erişmek ister."
        }
      ]
    ],
    "scheme": "swaglineai"
  }
}

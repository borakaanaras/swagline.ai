# GİZLİ — bu dosyanın kopyası olan `.env` git'e EKLENMEZ.
# https://replicate.com/account/api-tokens adresinden alınan token:
REPLICATE_API_TOKEN=
# Uygulamadaki EXPO_PUBLIC_DEV_SERVER_KEY ile aynı olmalı (yerel ağdaki başka cihazların kullanmasını zorlaştırır).
DEV_SERVER_KEY=
PORT=8787
# İsteğe bağlı: IDM-VTON sürümünü değiştirmek için
# IDM_VTON_VERSION=
